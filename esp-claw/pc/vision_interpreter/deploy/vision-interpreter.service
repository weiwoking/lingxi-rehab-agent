[Unit]
Description=Aliyun Vision Interpreter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/rehab/vision_interpreter
Environment=PYTHONUNBUFFERED=1
Environment=VISION_CONFIG_PATH=/opt/rehab/vision_interpreter/config/vision_config.json
EnvironmentFile=-/etc/vision-interpreter.env
ExecStart=/opt/rehab/vision_interpreter/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
