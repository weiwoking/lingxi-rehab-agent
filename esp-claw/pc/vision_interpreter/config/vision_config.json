    "rotation_deg": [
      0.0,
      0.0,
      0.0
    ]
  },
  "fusion": {
    "minimum_valid_zones": 1,
    "distance_method": "median",
    "outlier_mad_scale": 3.0,
    "left_boundary": 0.35,
    "right_boundary": 0.65
  },
  "geometry": {
    "algorithm": "opencv_pinhole_backprojection",
    "distance_definition": "tof_radial_aligned",
    "ground_tolerance_cm": 3.0,
    "minimum_object_height_cm": 1.0,
    "maximum_object_height_cm": 250.0,
    "minimum_bottom_height_cm": -10.0,
    "maximum_bottom_height_cm": 300.0
  },
  "model": {
    "path": "models/yolo11n.pt",
    "device": "cpu",
    "image_size": 640,
    "confidence_threshold": 0.35,
    "allowed_classes": [
      "person",
      "bottle",
      "cup",
      "chair",
      "bed",
      "table",
      "remote",
      "phone",
      "book"
    ],
    "zxl_class_name": "zxl",
    "normal_person_class_name": "person"
  },
  "person_follow": {
    "enabled": true,
    "logical_model_slot": "person_follow",
    "model_id": "coco-yolo11n",
    "model_path": "models/yolo11n.pt",
    "target_class": "person",
    "confidence_threshold": 0.35,
    "image_size": 640,
    "device": "cpu",
    "half": false,
    "max_image_bytes": 131072,
    "warmup": true
  },
  "identity": {
    "enabled": true,
    "model_path": "models/identity/best_zxl_identity.pt",
    "class_names": {
      "0": "person",
      "1": "zxl"
    },
    "input_size": 320,
    "zxl_class_index": 1,
    "person_class_index": 0,
    "bbox_expand_ratio": 0.05,
    "zxl_threshold": 0.95,
    "zxl_threshold_note": "provisional prototype threshold; not final product threshold",
    "safety_threshold": 0.86,
    "balanced_threshold": 0.74,
    "demo_threshold": 0.59,
    "max_zxl_per_image": 1,
    "minimum_crop_side_px": 32,
    "fail_open_as_person": true
  }
