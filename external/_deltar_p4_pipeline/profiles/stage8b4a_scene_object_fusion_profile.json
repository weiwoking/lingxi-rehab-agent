{
  "schema_version": "stage8b4a_scene_object_fusion_profile.v1",
  "profile_id": "stage8b4a_conservative_same_view_fusion_v1",
  "image_size": {
    "width": 640,
    "height": 360,
    "descriptor_width": 160,
    "descriptor_height": 90
  },
  "same_view": {
    "minimum_phase_peak_ratio": 50.0,
    "minimum_intensity_correlation": 0.8,
    "minimum_gradient_correlation": 0.5,
    "minimum_overlap_ratio": 0.75
  },
  "object_match": {
    "minimum_aligned_iou": 0.2,
    "maximum_normalized_center_distance": 0.65,
    "minimum_width_ratio": 0.4,
    "minimum_height_ratio": 0.5,
    "maximum_object_height_relative_difference": 0.45,
    "maximum_support_height_difference_mm": 250.0
  },
  "trusted_distance_statuses": [
    "verified",
    "validated",
    "trusted",
    "tof_verified"
  ],
  "untrusted_distance_statuses": [
    "dense_depth_unverified_for_thin_object"
  ],
  "recognition_confidence_floor": 0.25,
  "policy": {
    "same_class_only": true,
    "same_frame_merge_forbidden": true,
    "ambiguous_merge_forbidden": true,
    "cluster_may_not_contain_two_observations_from_one_frame": true,
    "insufficient_evidence_keeps_multiple_objects": true
  }
}
