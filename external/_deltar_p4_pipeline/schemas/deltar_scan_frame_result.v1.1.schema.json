    "formal": {"type": "object", "additionalProperties": false, "required": ["schema_version", "status", "canvas_selection_status", "selected_canvas", "selection_is_provisional", "single_canvas_only", "automatic_geometry_valid", "absolute_geometry_valid", "selected_source", "fallback_used", "fallback_reason", "critical_geometry_rejections", "attempts", "selected_geometry", "provenance"], "properties": {"schema_version": {"const": "deltar_stage4_geometry.v1.1"}, "status": {"enum": ["success", "rejected"]}, "canvas_selection_status": {"enum": ["agreed", "disagreed", "direct_only", "letterbox_only", "both_rejected"]}, "selected_canvas": {"type": ["string", "null"]}, "selection_is_provisional": {"type": "boolean"}, "single_canvas_only": {"type": "boolean"}, "automatic_geometry_valid": {"type": "boolean"}, "absolute_geometry_valid": {"type": "boolean"}, "selected_source": {"enum": ["segmentation", "matched_detection_fallback", "detection_fallback", null]}, "fallback_used": {"type": "boolean"}, "fallback_reason": {"type": ["string", "null"]}, "critical_geometry_rejections": {"type": "array", "items": {"type": "string"}}, "attempts": {"type": "array", "items": {"$ref": "#/$defs/attempt"}}, "selected_geometry": {"$ref": "#/$defs/selectedGeometry"}, "provenance": {"$ref": "#/$defs/provenance"}}},
    "visibility": {"type": "object", "additionalProperties": false, "required": ["schema_version", "partial_object", "visibility_status", "touches_image_border", "touches_top", "touches_bottom", "touches_left", "touches_right", "top_visible", "bottom_visible", "full_extent_visible", "occlusion_ratio_estimate", "distance_valid", "distance_semantics", "visible_height_valid", "physical_height_valid", "bottom_height_valid", "physical_height_m", "bottom_height_m", "warnings"], "properties": {"schema_version": {"const": "deltar_partial_object_visibility.v1"}, "partial_object": {"type": "boolean"}, "visibility_status": {"enum": ["complete", "partial", "unknown"]}, "touches_image_border": {"type": "boolean"}, "touches_top": {"type": "boolean"}, "touches_bottom": {"type": "boolean"}, "touches_left": {"type": "boolean"}, "touches_right": {"type": "boolean"}, "top_visible": {"type": "boolean"}, "bottom_visible": {"type": "boolean"}, "full_extent_visible": {"type": "boolean"}, "occlusion_ratio_estimate": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "distance_valid": {"type": "boolean"}, "distance_semantics": {"type": ["string", "null"]}, "visible_height_valid": {"type": "boolean"}, "physical_height_valid": {"type": "boolean"}, "bottom_height_valid": {"type": "boolean"}, "physical_height_m": {"type": ["number", "null"]}, "bottom_height_m": {"type": ["number", "null"]}, "warnings": {"type": "array", "items": {"type": "string"}}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["frame_object_id", "logical_object_id", "class_id", "class_name", "class_scope", "object_role", "object_source", "confidence", "bbox_xyxy", "distance_m", "distance_semantics", "centroid_3d_m", "geometry_point_count", "depth_compactness", "formal_geometry", "visibility", "visible_height", "physical_height", "bottom_height", "placement_level", "warnings", "errors", "rejection_reason", "provenance"], "properties": {"frame_object_id": {"type": "string"}, "logical_object_id": {"type": "string"}, "class_id": {"type": "integer", "minimum": 0}, "class_name": {"type": "string"}, "class_scope": {"enum": ["core_now", "supported_but_not_core", "future_custom_class"]}, "object_role": {"type": "string"}, "object_source": {"enum": ["segmentation", "matched_detection_fallback", "detection_fallback", "rejected"]}, "confidence": {"type": "number", "minimum": 0, "maximum": 1}, "bbox_xyxy": {"$ref": "#/$defs/bbox"}, "distance_m": {"type": ["number", "null"], "minimum": 0}, "distance_semantics": {"type": ["string", "null"]}, "centroid_3d_m": {"type": ["array", "null"], "minItems": 3, "maxItems": 3, "items": {"type": "number"}}, "geometry_point_count": {"type": "integer", "minimum": 0}, "depth_compactness": {"type": "number", "minimum": 0}, "formal_geometry": {"$ref": "#/$defs/formal"}, "visibility": {"$ref": "#/$defs/visibility"}, "visible_height": {"$ref": "#/$defs/height"}, "physical_height": {"$ref": "#/$defs/height"}, "bottom_height": {"$ref": "#/$defs/height"}, "placement_level": {"enum": ["ground", "low", "tabletop", "elevated", "unknown"]}, "warnings": {"$ref": "#/$defs/warnings"}, "errors": {"type": "array", "items": {"$ref": "#/$defs/error"}}, "rejection_reason": {"type": ["string", "null"]}, "provenance": {"type": "object", "additionalProperties": false, "required": ["frame_id", "model_hashes", "stage4_function"], "properties": {"frame_id": {"type": "string"}, "model_hashes": {"$ref": "#/$defs/provenance/properties/model_hashes"}, "stage4_function": {"const": "stage4_validation.process_object_group"}}}}}
  }
