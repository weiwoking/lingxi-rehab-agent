    "candidate": {"type": "object", "additionalProperties": false, "required": ["available", "class_id", "class_name", "confidence", "bbox_xyxy", "mask_key", "region_method", "statistic_method", "model_sha256"], "properties": {"available": {"type": "boolean"}, "segment_instance_id": {"type": ["integer", "null"], "minimum": 0}, "detect_instance_id": {"type": ["integer", "null"], "minimum": 0}, "class_id": {"type": ["integer", "null"], "minimum": 0}, "class_name": {"type": ["string", "null"]}, "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}, "bbox_xyxy": {"type": "array", "maxItems": 4, "items": {"type": "number"}}, "mask_key": {"type": ["string", "null"]}, "region_method": {"enum": ["segment_eroded_3px", "bbox_full", null]}, "statistic_method": {"enum": ["mad_median", "median", null]}, "model_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}}},
    "group": {"type": "object", "additionalProperties": false, "required": ["logical_object_id", "class_id", "class_name", "segmentation_primary", "detection_fallback", "match", "provenance"], "properties": {"logical_object_id": {"type": "string"}, "class_id": {"type": "integer", "minimum": 0}, "class_name": {"type": "string"}, "segmentation_primary": {"$ref": "#/$defs/candidate"}, "detection_fallback": {"$ref": "#/$defs/candidate"}, "match": {"type": "object", "additionalProperties": false, "required": ["status", "iou"], "properties": {"status": {"enum": ["matched", "unmatched_segmentation", "unmatched_detection"]}, "iou": {"type": ["number", "null"], "minimum": 0, "maximum": 1}}}, "provenance": {"$ref": "#/$defs/provenance"}}},
