    "height": {"type": "object", "additionalProperties": false, "required": ["value_m", "available", "absolute_valid"], "properties": {"value_m": {"type": ["number", "null"]}, "available": {"type": "boolean"}, "absolute_valid": {"type": "boolean"}}},
    "selectedGeometry": {"type": ["object", "null"], "additionalProperties": false, "required": ["distance_m", "object_height_m", "bottom_height_m", "point_count", "mask_support"], "properties": {"distance_m": {"type": "number", "minimum": 0}, "object_height_m": {"type": "number", "minimum": 0}, "bottom_height_m": {"type": "number"}, "point_count": {"type": "integer", "minimum": 0}, "mask_support": {"type": "integer", "minimum": 0}}},
