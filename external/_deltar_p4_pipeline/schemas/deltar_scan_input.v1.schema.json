{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deltar_scan_input.v1.schema.json",
  "title": "DELTAR Scan Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scan_id", "created_at", "frame_count", "capture_mode", "device", "profiles", "notes"],
  "properties": {
    "schema_version": {"const": "deltar_scan_input.v1"},
    "scan_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_-]+$"},
    "created_at": {"type": "string", "format": "date-time", "maxLength": 64},
    "frame_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "capture_mode": {"enum": ["single_frame", "multi_frame"]},
    "device": {
      "type": "object", "additionalProperties": false, "required": ["board", "camera", "tof"],
      "properties": {
        "board": {"type": "string", "minLength": 1, "maxLength": 64},
        "camera": {"type": "string", "minLength": 1, "maxLength": 64},
        "tof": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "profiles": {
      "type": "object", "additionalProperties": false,
      "required": ["camera_profile_id", "tof_profile_id", "calibration_profile_id", "algorithm_profile_id", "scan_strategy_profile_id"],
      "properties": {
        "camera_profile_id": {"const": "camera_sc2336_640x360_rgb565_v1"},
        "tof_profile_id": {"const": "tof_vl53l5cx_orientation_identity_v1"},
        "calibration_profile_id": {"const": "calibration_unverified_stage6_v1"},
        "algorithm_profile_id": {"const": "algorithm_stage6_official_v1"},
        "scan_strategy_profile_id": {"const": "scan_strategy_stage6_guidance_v1"}
      }
    },
    "notes": {"type": ["string", "null"], "maxLength": 512}
  }
}
