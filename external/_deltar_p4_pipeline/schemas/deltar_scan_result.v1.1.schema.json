{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deltar_scan_result.v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "scan_id", "job_id", "input", "models", "profiles", "objects", "warnings", "errors", "aggregation", "provenance", "processing"],
  "properties": {
    "schema_version": {"const": "deltar_scan_result.v1.1"},
    "status": {"enum": ["success", "partial_success", "rejected", "failed"]},
    "scan_id": {"type": "string", "minLength": 1},
    "job_id": {"type": "string", "minLength": 1},
    "input": {"type": "object", "additionalProperties": false, "required": ["frame_count", "valid_frame_count", "rejected_frame_count", "rejected_frames"], "properties": {"frame_count": {"type": "integer", "minimum": 1}, "valid_frame_count": {"type": "integer", "minimum": 0}, "rejected_frame_count": {"type": "integer", "minimum": 0}, "rejected_frames": {"type": "array", "items": {"type": "object"}}}},
    "models": {"$ref": "deltar_scan_frame_result.v1.1.schema.json#/$defs/models"},
    "profiles": {"type": "object"},
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}},
    "warnings": {"type": "array", "items": {"type": "string", "pattern": "^W_[A-Z0-9_]+$"}, "uniqueItems": true},
    "errors": {"type": "array", "items": {"type": "object"}},
    "aggregation": {"type": "object", "additionalProperties": false, "required": ["input_observation_count", "association_group_count", "output_object_count", "filtered_non_core_count", "gt_used_for_association"], "properties": {"input_observation_count": {"type": "integer", "minimum": 0}, "association_group_count": {"type": "integer", "minimum": 0}, "output_object_count": {"type": "integer", "minimum": 0}, "filtered_non_core_count": {"type": "integer", "minimum": 0}, "gt_used_for_association": {"const": false}}},
    "provenance": {"type": "object"},
    "processing": {"type": "object"}
  },
  "$defs": {
    "height": {"type": "object", "additionalProperties": false, "required": ["value_m", "available", "absolute_valid"], "properties": {"value_m": {"type": ["number", "null"]}, "available": {"type": "boolean"}, "absolute_valid": {"type": "boolean"}}},
    "visibility": {"type": "object", "additionalProperties": false, "required": ["status", "top_visible", "bottom_visible", "full_extent_visible"], "properties": {"status": {"enum": ["complete", "partial", "unknown"]}, "top_visible": {"type": "boolean"}, "bottom_visible": {"type": "boolean"}, "full_extent_visible": {"type": "boolean"}}},
    "best": {"type": "object", "additionalProperties": false, "required": ["frame_id", "frame_object_id", "selected_source", "canvas_selection_status", "formal_stage4_selected"], "properties": {"frame_id": {"type": "string"}, "frame_object_id": {"type": "string"}, "selected_source": {"enum": ["segmentation", "matched_detection_fallback", "detection_fallback"]}, "canvas_selection_status": {"enum": ["agreed", "direct_only", "letterbox_only"]}, "formal_stage4_selected": {"const": true}}},
    "object": {"type": "object", "additionalProperties": false, "required": ["scan_object_id", "class_id", "class_name", "class_scope", "object_role", "observation_count", "frame_ids", "best_observation_frame_id", "best_observation_score", "best_observation_reason", "best_observation", "distance_observations_m", "visibility_observations", "visibility", "distance", "visible_height", "physical_height", "bottom_height", "placement_level", "warnings", "rejection_reason", "aggregation_status", "provenance"], "properties": {"scan_object_id": {"type": "string"}, "class_id": {"type": "integer", "minimum": 0}, "class_name": {"type": "string"}, "class_scope": {"enum": ["core_now", "supported_but_not_core", "future_custom_class"]}, "object_role": {"type": "string"}, "observation_count": {"type": "integer", "minimum": 1}, "frame_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true}, "best_observation_frame_id": {"type": "string"}, "best_observation_score": {"type": "number"}, "best_observation_reason": {"type": "array", "items": {"type": "string"}}, "best_observation": {"$ref": "#/$defs/best"}, "distance_observations_m": {"type": "array", "items": {"type": "number", "minimum": 0}}, "visibility_observations": {"type": "array", "items": {"enum": ["complete", "partial", "unknown"]}}, "visibility": {"$ref": "#/$defs/visibility"}, "distance": {"type": "object", "additionalProperties": false, "required": ["value_m", "semantics", "valid", "source_frame_id"], "properties": {"value_m": {"type": ["number", "null"], "minimum": 0}, "semantics": {"type": ["string", "null"]}, "valid": {"type": "boolean"}, "source_frame_id": {"type": "string"}}}, "visible_height": {"$ref": "#/$defs/height"}, "physical_height": {"$ref": "#/$defs/height"}, "bottom_height": {"$ref": "#/$defs/height"}, "placement_level": {"enum": ["ground", "low", "tabletop", "elevated", "unknown"]}, "warnings": {"type": "array", "items": {"type": "string", "pattern": "^W_[A-Z0-9_]+$"}}, "rejection_reason": {"type": ["string", "null"]}, "aggregation_status": {"enum": ["single_observation", "conservative_match"]}, "provenance": {"type": "object", "additionalProperties": false, "required": ["source_frame_object_ids", "best_observation_only_for_geometry", "model_hashes", "stage4_function"], "properties": {"source_frame_object_ids": {"type": "array", "items": {"type": "string"}}, "best_observation_only_for_geometry": {"const": true}, "model_hashes": {"type": "object", "additionalProperties": false, "required": ["depth", "detect", "segment"], "properties": {"depth": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "detect": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "segment": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}, "stage4_function": {"const": "stage4_validation.process_object_group"}}}}}
  }
}
