{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "camera_world_capture.v1",
  "title": "Stage 7C-1 Camera world capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capture_id", "created_at",
    "camera_profile_path", "camera_profile_id", "camera_profile_sha256",
    "camera_tof_profile_path", "camera_tof_profile_id",
    "camera_tof_profile_sha256", "board_manifest_path",
    "board_manifest_sha256", "world_frame", "camera_height_mm",
    "camera_height_uncertainty_mm", "board_alignment",
    "board_origin_height_above_floor_mm", "poses"
  ],
  "properties": {
    "schema_version": {"const": "camera_world_capture.v1"},
    "capture_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "camera_profile_path": {"type": "string", "minLength": 1},
    "camera_profile_id": {"type": "string", "minLength": 1},
    "camera_profile_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "camera_tof_profile_path": {
      "const": "C:\\calibration\\stage7b_result_unitfix_20260724_012041\\camera_tof_extrinsics.v1.json"
    },
    "camera_tof_profile_id": {"const": "camera_tof_extrinsics_6698a99489d42fb2"},
    "camera_tof_profile_sha256": {
      "const": "dbcb5792338f50cca953c365e436e17d9f044b2f47bcca716e697308dda7f8b5"
    },
    "board_manifest_path": {"type": "string", "minLength": 1},
    "board_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "world_frame": {"$ref": "#/$defs/world_frame"},
    "camera_height_mm": {"const": 969},
    "camera_height_uncertainty_mm": {"const": 5},
    "board_alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vertical", "top_edge_horizontal", "front_faces_vehicle",
        "vehicle_forward_perpendicular_to_board",
        "setup_angle_uncertainty_deg"
      ],
      "properties": {
        "vertical": {"const": true},
        "top_edge_horizontal": {"const": true},
        "front_faces_vehicle": {"const": true},
        "vehicle_forward_perpendicular_to_board": {"const": true},
        "setup_angle_uncertainty_deg": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 0.5
        }
      }
    },
    "board_origin_height_above_floor_mm": {
      "type": ["number", "null"], "exclusiveMinimum": 0
    },
    "poses": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pose_name", "role", "stationary_confirmed",
          "approximate_distance_mm", "alignment_confirmed", "notes"
        ],
        "properties": {
          "pose_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "role": {
            "enum": ["world_front_near", "world_front_mid", "world_front_far"]
          },
          "scan_dir": {"type": "string", "minLength": 1},
          "scan_dirs": {
            "type": "array", "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "stationary_confirmed": {"const": true},
          "approximate_distance_mm": {"type": "number", "exclusiveMinimum": 0},
          "alignment_confirmed": {"const": true},
          "notes": {"type": "string"}
        },
        "oneOf": [
          {"required": ["scan_dir"], "not": {"required": ["scan_dirs"]}},
          {"required": ["scan_dirs"], "not": {"required": ["scan_dir"]}}
        ]
      }
    }
  },
  "$defs": {
    "world_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x_axis", "y_axis", "z_axis", "origin", "translation_unit"],
      "properties": {
        "x_axis": {"const": "vehicle_right"},
        "y_axis": {"const": "vehicle_forward"},
        "z_axis": {"const": "up"},
        "origin": {"const": "ground_point_below_camera_optical_centre"},
        "translation_unit": {"const": "mm"}
      }
    }
  }
}
