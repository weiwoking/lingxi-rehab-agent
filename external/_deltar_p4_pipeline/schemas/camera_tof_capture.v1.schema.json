{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "camera_tof_capture.v1",
  "title": "Stage 7B Camera-ToF capture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "capture_id", "created_at", "camera_profile",
    "camera_profile_sha256", "board_manifest", "board_manifest_sha256",
    "backer", "poses"
  ],
  "properties": {
    "schema_version": {"const": "camera_tof_capture.v1"},
    "capture_id": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
    "created_at": {"type": "string", "format": "date-time"},
    "camera_profile": {"type": "string", "minLength": 1},
    "camera_profile_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "board_manifest": {"type": "string", "minLength": 1},
    "board_manifest_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "backer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_mm", "height_mm", "material", "matte", "opaque"],
      "properties": {
        "width_mm": {"type": "number", "exclusiveMinimum": 0},
        "height_mm": {"type": "number", "exclusiveMinimum": 0},
        "material": {"type": "string", "minLength": 1},
        "matte": {"const": true},
        "opaque": {"const": true}
      }
    },
    "poses": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pose_name", "split", "scan_dir", "stationary_confirmed",
          "estimated_distance_mm", "tilt_hint", "image_region_hint", "notes"
        ],
        "properties": {
          "pose_name": {"type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$"},
          "split": {"enum": ["train", "heldout"]},
          "scan_dir": {
            "oneOf": [
              {"type": "string", "minLength": 1},
              {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            ]
          },
          "stationary_confirmed": {"const": true},
          "estimated_distance_mm": {"type": "number", "exclusiveMinimum": 0},
          "tilt_hint": {"type": "string"},
          "image_region_hint": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
