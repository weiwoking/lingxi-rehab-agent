/outputs_stage5_2a/
/outputs_stage5_2b/
/outputs_stage6/
/outputs_stage6_1/
/outputs_stage6_2/
/outputs_stage7a/
/tmp/
/_codex_tmp_stage5_yolo/

# Project models are preserved by the root archive (exact Git LFS paths).

