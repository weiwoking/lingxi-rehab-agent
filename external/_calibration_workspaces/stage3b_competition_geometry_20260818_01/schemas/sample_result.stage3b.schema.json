    "role": {"enum": ["PRIMARY_COMPETITION_VIEW", "ROBUSTNESS_EXTRA"]},
    "raw_geometry_authority": {"const": "RAW_GEOMETRY_BEFORE_STABILIZER"},
    "horizontal_world_authority": {"const": "NOT_VALIDATED"}
  }
}
