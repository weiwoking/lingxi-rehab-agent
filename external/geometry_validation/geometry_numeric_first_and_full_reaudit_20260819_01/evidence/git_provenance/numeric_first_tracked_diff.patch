-def _contour_distance_transform(contour_mask: np.ndarray) -> np.ndarray:
-    if cv2 is not None:
-        return cv2.distanceTransform(
-            (~contour_mask.astype(bool)).astype(np.uint8), cv2.DIST_L2, 3
-        )
-    # Deterministic 3x3 chamfer fallback for lightweight test environments.
-    distance = np.full(contour_mask.shape, np.inf, dtype=np.float64)
-    distance[contour_mask.astype(bool)] = 0.0
-    axial_weight = 0.955
-    diagonal_weight = 1.3693
-    height, width = distance.shape
-    for y in range(height):
-        for x in range(width):
-            current = distance[y, x]
-            if y:
-                current = min(current, distance[y - 1, x] + axial_weight)
-                if x:
-                    current = min(current, distance[y - 1, x - 1] + diagonal_weight)
-                if x + 1 < width:
-                    current = min(current, distance[y - 1, x + 1] + diagonal_weight)
-            if x:
-                current = min(current, distance[y, x - 1] + axial_weight)
-            distance[y, x] = current
-    for y in range(height - 1, -1, -1):
-        for x in range(width - 1, -1, -1):
-            current = distance[y, x]
-            if y + 1 < height:
-                current = min(current, distance[y + 1, x] + axial_weight)
-                if x:
-                    current = min(current, distance[y + 1, x - 1] + diagonal_weight)
-                if x + 1 < width:
-                    current = min(current, distance[y + 1, x + 1] + diagonal_weight)
-            if x + 1 < width:
-                current = min(current, distance[y, x + 1] + axial_weight)
-            distance[y, x] = current
-    return distance
