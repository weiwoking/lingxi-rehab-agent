-        "percentile_stability": max(0.0, 1.0 - float(factors["percentile_delta_mm"]) / float(norms["percentile_delta_bad_mm"])),
-        "axial_depth_dispersion": max(0.0, 1.0 - float(factors["depth_iqr_mm"]) / float(norms["depth_iqr_bad_mm"])),
-        "world_z_dispersion": max(0.0, 1.0 - float(factors["world_z_iqr_mm"]) / float(norms["world_z_iqr_bad_mm"])),
-        "not_touches_border": 0.0 if bool(factors["touches_border"]) else 1.0,
